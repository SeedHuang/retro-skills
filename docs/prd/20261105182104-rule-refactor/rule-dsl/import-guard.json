{
  "id": "import-guard",
  "impl": "script",
  "title": "编辑代码后必须真实验证且 import 不丢",
  "when": { "field": "edited", "op": "eq", "value": true },
  "assert": [
    { "field": "verifyCommand", "op": "nonEmpty" },
    { "field": "verifyOutput", "op": "nonEmpty" },
    { "field": "importTogether", "op": "eq", "value": true },
    { "field": "reread", "op": "eq", "value": true }
  ],
  "residual": { "who": "reviewer-audit", "sample": 3, "fields": ["verifyOutput", "importTogether"] },
  "landing": "edit-record"
}
