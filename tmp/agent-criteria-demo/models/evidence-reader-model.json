{
  "version": 2,
  "id": "evidence-reader",
  "extends": "_shared-model.json",
  "seat": {
    "id": "evidence-reader",
    "display": "取证",
    "triggers": [
      {
        "id": "handoff"
      },
      {
        "id": "fact-baseline"
      }
    ],
    "description": {
      "template": "当需要通读长文并交出可核对的原文与行号（{triggers}）",
      "joiner": "、",
      "lastJoiner": "、"
    },
    "artifacts": [
      "artifact.factSummary"
    ],
    "tier": "readOnly"
  },
  "duty": {
    "trigger": {
      "from": "seat.description"
    },
    "action": {
      "verb": "取证通读",
      "scope": "取证",
      "objects": [
        "长文（对话记录、评审账、规范原文）"
      ],
      "emit": [
        "原文",
        "行号"
      ],
      "landingSubject": "结论",
      "landing": "outputs.items",
      "landingJoiner": "与 "
    }
  },
  "defaultLanding": "artifact.factSummary",
  "checklist": {
    "items": [
      {
        "no": 1,
        "seatPrefix": "取证席卡",
        "category": "摘句行号核对",
        "criterion": "evidence.line"
      },
      {
        "no": 2,
        "seatPrefix": "取证席卡",
        "category": "原文与概括核对",
        "criterion": "evidence.paraphrase"
      },
      {
        "no": 3,
        "seatPrefix": "取证席卡",
        "category": "未找到清单核对",
        "criterion": "evidence.notfound"
      },
      {
        "no": 4,
        "seatPrefix": "取证席卡",
        "category": "二手转述核对",
        "criterion": "evidence.secondhand"
      },
      {
        "no": 5,
        "seatPrefix": "取证席卡",
        "category": "长文截断核对",
        "criterion": "evidence.truncated"
      },
      {
        "no": 6,
        "seatPrefix": "取证席卡",
        "category": "只交事实核对",
        "criterion": "evidence.factsOnly"
      }
    ]
  },
  "checkCriteria": {
    "evidence.line": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "quoteInLine",
          "ofRef": "evidenceTriple",
          "path": "path",
          "line": "line",
          "quote": "quote"
        }
      ],
      "negative": {
        "input": {
          "evidenceTriple": {
            "path": "a.md",
            "line": 3,
            "quote": "与原文不符"
          }
        },
        "expect": "fail",
        "failsOn": "evidenceTriple.quote"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "machineCmd": "scs check landings --ledger"
        }
      }
    },
    "evidence.paraphrase": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "evidenceTriple",
          "field": "paraphrase"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "evidenceTriple",
          "field": "quote"
        }
      ],
      "negative": {
        "input": {
          "evidenceTriple": {
            "paraphrase": "概括",
            "quote": ""
          }
        },
        "expect": "fail",
        "failsOn": "evidenceTriple.quote"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    "evidence.notfound": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "notFound",
          "field": "reason"
        }
      ],
      "negative": {
        "input": {
          "notFound": {
            "reason": ""
          }
        },
        "expect": "fail",
        "failsOn": "notFound.reason"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "SCHEMA_UNFROZEN"
        }
      }
    },
    "evidence.secondhand": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "quoteInLine",
          "ofRef": "evidenceTriple",
          "path": "path",
          "line": "line",
          "quote": "quote"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "evidenceTriple",
          "field": "purpose"
        }
      ],
      "negative": {
        "input": {
          "evidenceTriple": {
            "path": "a.md",
            "line": 1,
            "quote": "x",
            "purpose": ""
          }
        },
        "expect": "fail",
        "failsOn": "evidenceTriple.purpose"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    "evidence.truncated": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "truncation",
          "field": "marker"
        }
      ],
      "negative": {
        "input": {
          "truncation": {
            "marker": ""
          }
        },
        "expect": "fail",
        "failsOn": "truncation.marker"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "SCHEMA_UNFROZEN"
        }
      }
    },
    "evidence.factsOnly": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldEmpty",
          "ofRef": "deliverableBody",
          "field": "opinion"
        }
      ],
      "negative": {
        "input": {
          "deliverableBody": {
            "opinion": "我认为这个方案不好"
          }
        },
        "expect": "fail",
        "failsOn": "deliverableBody.opinion"
      },
      "residual": {
        "who": "evidence-reader",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    }
  },
  "outputFormat": {
    "title": "输出格式",
    "requiredFields": [
      {
        "id": "quote",
        "label": "原文摘句",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "location",
        "label": "文件 + 行号",
        "type": "pathLine",
        "required": true
      },
      {
        "id": "purpose",
        "label": "用途",
        "type": "nonEmpty",
        "required": true
      }
    ],
    "checks": [
      {
        "id": "quote-verifiable",
        "observable": {
          "op": "quoteInLine",
          "ofRef": "evidenceTriple",
          "path": "path",
          "line": "line",
          "quote": "quote"
        }
      },
      {
        "id": "notfound-explained",
        "observable": {
          "op": "allExist",
          "ofRef": "notFound"
        }
      }
    ]
  },
  "templates": {
    "pl.fact-summary": {
      "skill": "parliament-ledger",
      "label": "事实摘要",
      "columns": [
        "quote",
        "location",
        "purpose"
      ]
    }
  },
  "outputs": {
    "items": [
      {
        "phase": "每轮",
        "artifact": "artifact.factSummary",
        "template": "pl.fact-summary",
        "action": "fill",
        "mode": "each",
        "section": "取证"
      }
    ]
  },
  "forms": {
    "artifact.factSummary": {
      "text": "`evidence.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/evidence.md"
    }
  },
  "records": {
    "anchor": {
      "source": {
        "kind": "description",
        "text": "事实摘要"
      }
    },
    "evidenceTriple": {
      "label": "证据三元组",
      "unit": "一条证据",
      "source": {
        "kind": "description",
        "text": "事实摘要"
      },
      "shape": [
        {
          "id": "quote",
          "label": "原文摘句",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "path",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "line",
          "label": "行号",
          "type": "int",
          "min": 1,
          "required": true
        },
        {
          "id": "purpose",
          "label": "用途",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "paraphrase",
          "label": "概括",
          "type": "nonEmpty",
          "required": false
        }
      ],
      "verify": {
        "op": "quoteInLine",
        "path": "path",
        "line": "line",
        "quote": "quote"
      }
    },
    "notFound": {
      "label": "未找到项",
      "unit": "一条未找到记录",
      "source": {
        "kind": "description",
        "text": "事实摘要"
      },
      "shape": [
        {
          "id": "target",
          "label": "查找对象",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "reason",
          "label": "未找到原因",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "truncation": {
      "label": "截断标记",
      "unit": "一处截断",
      "source": {
        "kind": "description",
        "text": "事实摘要"
      },
      "shape": [
        {
          "id": "marker",
          "label": "截断标记",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "deliverableBody": {
      "label": "交付物正文",
      "unit": "一段正文",
      "source": {
        "kind": "description",
        "text": "交付物正文"
      },
      "shape": [
        {
          "id": "opinion",
          "label": "观点",
          "type": "nonEmpty",
          "required": false
        }
      ]
    }
  },
  "escalation": null,
  "permissions": {
    "policy": "denyByDefault",
    "action": {
      "allow": [
        "evidence-read",
        "record"
      ],
      "forbid": [
        "opinion",
        "issue-card",
        "participate-review",
        "tech-verdict"
      ]
    },
    "write": {
      "allow": [
        "artifact.factSummary"
      ],
      "forbidForms": []
    },
    "command": {
      "allow": [],
      "forbidForms": []
    }
  },
  "boundary": {
    "kind": "literal",
    "text": "你是只读取证角色：不得创建、修改、删除任何文件；不出观点、不出问题卡、不参与评审、不判技术对错；只交可核对的原文与行号。"
  }
}
