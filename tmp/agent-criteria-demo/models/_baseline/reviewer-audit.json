{
  "version": 2,
  "id": "audit-seat",
  "extends": "_shared-model.json",
  "seat": {
    "id": "reviewer-audit",
    "display": "审计",
    "triggers": [
      {
        "id": "process-check"
      },
      {
        "id": "round-reconcile"
      },
      {
        "id": "delivery-check"
      }
    ],
    "description": {
      "template": "当议会评审需要{triggers}",
      "joiner": "、",
      "lastJoiner": "或"
    },
    "artifacts": [
      "artifact.roundCheck",
      "artifact.deliveryAudit"
    ]
  },
  "duty": {
    "trigger": {
      "from": "seat.description"
    },
    "action": {
      "verb": "核对",
      "scope": "过程标准",
      "objects": [
        "评审过程",
        "交付物"
      ],
      "emit": [
        "判定",
        "理由"
      ],
      "landingSubject": {
        "from": "emit",
        "index": 0
      },
      "landing": "outputs.items",
      "landingJoiner": "与 "
    }
  },
  "timing": {
    "scene": "deliverable",
    "moment": "end",
    "repeat": "per-round"
  },
  "defaultLanding": "artifact.roundCheck",
  "checklist": {
    "items": [
      {
        "no": 1,
        "seatPrefix": "审计席卡",
        "category": "卡片合规核对",
        "criterion": "audit.card"
      },
      {
        "no": 2,
        "seatPrefix": "审计席卡",
        "category": "级别匹配核对",
        "criterion": "audit.level"
      },
      {
        "no": 3,
        "seatPrefix": "审计席卡",
        "category": "答辩合规核对",
        "criterion": "audit.defense"
      },
      {
        "no": 4,
        "seatPrefix": "审计席卡",
        "category": "计数一致核对",
        "criterion": "audit.count"
      },
      {
        "no": 5,
        "seatPrefix": "审计席卡",
        "category": "轮际对账核对",
        "criterion": "audit.round"
      },
      {
        "no": 6,
        "seatPrefix": "审计席卡",
        "category": "落点真实核对",
        "criterion": "audit.spot"
      },
      {
        "no": 7,
        "seatPrefix": "审计席卡",
        "category": "证据复算核对",
        "criterion": "audit.evidence"
      },
      {
        "no": 8,
        "seatPrefix": "审计席卡",
        "category": "转录核对",
        "criterion": "audit.transcript"
      }
    ]
  },
  "checkCriteria": {
    "audit.card": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "coversAll",
          "ofRef": "cardField",
          "field": "id",
          "required": [
            "cardNo",
            "proposer",
            "dimension",
            "description",
            "quote",
            "location",
            "purpose",
            "severity",
            "suggestion"
          ]
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "issueCard",
          "field": "suggestion"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "issueCard",
          "field": "quote"
        }
      ],
      "negative": {
        "input": {
          "cardField": [
            {
              "id": "suggestion"
            }
          ],
          "issueCard": {
            "suggestion": "优化一下",
            "quote": ""
          }
        },
        "expect": "fail",
        "failsOn": "issueCard.quote"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "SCHEMA_UNFROZEN"
        }
      }
    },
    "audit.level": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "countGte",
          "ofRef": "conflictEvidence",
          "value": 2
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "levelProof",
          "field": "triggerSeq"
        }
      ],
      "negative": {
        "input": {
          "conflictEvidence": [
            {
              "source": "a.md:1"
            }
          ],
          "levelProof": {
            "triggerSeq": ""
          }
        },
        "expect": "fail",
        "failsOn": "levelProof.triggerSeq"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RULE_NOT_ENUMERATED"
        }
      }
    },
    "audit.defense": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "defense",
          "field": "verdict"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "defense",
          "field": "fixLanding"
        }
      ],
      "negative": {
        "input": {
          "defense": {
            "verdict": "成立",
            "fixLanding": ""
          }
        },
        "expect": "fail",
        "failsOn": "defense.fixLanding"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    "audit.count": {
      "action": "recount",
      "mode": "all",
      "observable": [
        {
          "op": "fieldsEq",
          "ofRef": "directionCount",
          "left": "sum",
          "right": "cards"
        }
      ],
      "negative": {
        "input": {
          "directionCount": {
            "sum": 4,
            "cards": 3
          }
        },
        "expect": "fail",
        "failsOn": "directionCount.sum"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "NO_MACHINE_OUTPUT"
        }
      }
    },
    "audit.round": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "setSubset",
          "ofRef": "promise",
          "field": "text",
          "within": "roundCheck",
          "withinField": "item"
        }
      ],
      "negative": {
        "input": {
          "promise": [
            {
              "text": "修复 X"
            }
          ],
          "roundCheck": [
            {
              "item": "其他"
            }
          ]
        },
        "expect": "fail",
        "failsOn": "promise.text"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    },
    "audit.spot": {
      "action": "spotCheck",
      "mode": "all",
      "observable": [
        {
          "op": "lineExists",
          "ofRef": "spotCheck",
          "path": "path",
          "line": "line"
        }
      ],
      "negative": {
        "input": {
          "spotCheck": {
            "path": "a.md",
            "line": 9999
          }
        },
        "expect": "fail",
        "failsOn": "spotCheck.line"
      },
      "objective": {
        "target": "machine",
        "machineCmd": "scs check landings --ledger"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "machineCmd": "scs check landings --ledger"
        }
      }
    },
    "audit.evidence": {
      "action": "replay",
      "mode": "all",
      "observable": [
        {
          "op": "fieldsEq",
          "ofRef": "evidenceLine",
          "left": "expectedFirstLine",
          "right": "actualFirstLine"
        }
      ],
      "negative": {
        "input": {
          "evidenceLine": {
            "command": "scs time",
            "expectedFirstLine": "2026-11-10",
            "actualFirstLine": "2026-11-11"
          }
        },
        "expect": "fail",
        "failsOn": "evidenceLine.expectedFirstLine"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "CMD_NOT_WHITELISTED"
        }
      }
    },
    "audit.transcript": {
      "action": "compare",
      "mode": "all",
      "observable": [
        {
          "op": "quoteInLine",
          "ofRef": "gateRecord",
          "path": "path",
          "line": "line",
          "quote": "quote"
        }
      ],
      "negative": {
        "input": {
          "gateRecord": {
            "path": "gate-record.md",
            "line": 3,
            "quote": "与原文不同"
          }
        },
        "expect": "fail",
        "failsOn": "gateRecord.quote"
      },
      "residual": {
        "who": "reviewer-audit",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    }
  },
  "templates": {
    "pl.round-check": {
      "skill": "parliament-ledger",
      "label": "轮间核对单",
      "columns": [
        "no",
        "item",
        "criterion",
        "kind",
        "verdict",
        "reason",
        "applicability",
        "evidence"
      ]
    },
    "pl.delivery-audit": {
      "skill": "parliament-ledger",
      "label": "交付审计表",
      "columns": [
        "no",
        "item",
        "criterion",
        "kind",
        "verdict",
        "reason",
        "applicability",
        "evidence"
      ]
    }
  },
  "outputs": {
    "items": [
      {
        "phase": "每轮",
        "artifact": "artifact.roundCheck",
        "template": "pl.round-check",
        "action": "fill",
        "mode": "each"
      },
      {
        "phase": "终局",
        "artifact": "artifact.deliveryAudit",
        "template": "pl.delivery-audit",
        "action": "fill",
        "mode": "whole"
      }
    ]
  },
  "forms": {
    "artifact.round-check": {
      "text": "`round-check.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/round-check.md",
      "requires": "write"
    },
    "cmd.scs.time": {
      "text": "`scs time`",
      "kind": "command",
      "prefix": "scs time",
      "requires": "exec"
    },
    "cmd.git.status": {
      "text": "`git --no-optional-locks status --porcelain`",
      "kind": "command",
      "prefix": "git --no-optional-locks status --porcelain",
      "requires": "exec"
    },
    "cmd.git.diff": {
      "text": "`git --no-optional-locks diff`",
      "kind": "command",
      "prefix": "git --no-optional-locks diff",
      "requires": "exec"
    },
    "cmd.git.log": {
      "text": "`git --no-optional-locks log`",
      "kind": "command",
      "prefix": "git --no-optional-locks log",
      "requires": "exec"
    },
    "path.parentEscape": {
      "text": "`..`",
      "kind": "pattern",
      "match": "\\.\\."
    },
    "form.fs.output": {
      "text": "`--output`",
      "kind": "forbiddenForm",
      "match": "--output",
      "requires": "exec"
    },
    "form.fs.apply": {
      "text": "`--apply`",
      "kind": "forbiddenForm",
      "match": "--apply",
      "requires": "exec"
    },
    "form.fs.write": {
      "text": "`--write`",
      "kind": "forbiddenForm",
      "match": "--write",
      "requires": "exec"
    },
    "form.fs.redirect": {
      "text": "`>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)\\d*>>?\\s*\\S",
      "requires": "exec"
    },
    "form.fs.append": {
      "text": "`>>`",
      "kind": "forbiddenForm",
      "match": ">>",
      "requires": "exec"
    },
    "form.env.export": {
      "text": "`export VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)export\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.set": {
      "text": "`set VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)set\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.setx": {
      "text": "`setx VAR …`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)setx\\s+\\w+",
      "requires": "exec"
    },
    "form.env.envcmd": {
      "text": "`env VAR=… <命令>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)env\\s+\\w+=",
      "requires": "exec"
    },
    "form.env.psenv": {
      "text": "`$env:VAR=…`",
      "kind": "forbiddenForm",
      "match": "\\$env:\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.prefix": {
      "text": "`VAR=… <命令>` 前缀",
      "kind": "forbiddenForm",
      "match": "^\\s*(\\w+=\\S*\\s+)+(\\S)",
      "requires": "exec"
    },
    "form.env.line": {
      "text": "整行 `VAR=…`",
      "kind": "forbiddenForm",
      "match": "^\\s*\\w+=\\S*\\s*$",
      "requires": "exec"
    },
    "artifact.deliveryAudit": {
      "text": "`delivery-audit.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/delivery-audit.md",
      "requires": "write"
    },
    "artifact.escalationReport": {
      "text": "`progress.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/progress.md",
      "requires": "write"
    },
    "cmd.scs.ledger.gate": {
      "text": "`scs ledger gate`",
      "kind": "command",
      "prefix": "scs ledger gate",
      "requires": "exec"
    },
    "cmd.scs.ledger.numbers": {
      "text": "`scs ledger numbers`",
      "kind": "command",
      "prefix": "scs ledger numbers",
      "requires": "exec"
    },
    "cmd.scs.ledger.landings": {
      "text": "`scs check landings --ledger`",
      "kind": "command",
      "prefix": "scs check landings --ledger",
      "requires": "exec"
    },
    "cmd.git.show": {
      "text": "`git --no-optional-locks show`",
      "kind": "command",
      "prefix": "git --no-optional-locks show",
      "requires": "exec"
    },
    "cmd.git.reflog": {
      "text": "`git --no-optional-locks reflog show`",
      "kind": "command",
      "prefix": "git --no-optional-locks reflog show",
      "requires": "exec"
    },
    "artifact.roundCheck": {
      "text": "`round-check.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/round-check.md"
    }
  },
  "records": {
    "anchor": {
      "label": "依据锚",
      "unit": "一个锚点",
      "source": {
        "kind": "description",
        "text": "交付物正文的结论段"
      },
      "shape": [
        {
          "id": "path",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "line",
          "label": "行号",
          "type": "int",
          "min": 1,
          "required": true
        },
        {
          "id": "quote",
          "label": "摘句",
          "type": "nonEmpty",
          "required": true
        }
      ],
      "verify": {
        "op": "quoteInLine",
        "path": "path",
        "line": "line",
        "quote": "quote"
      }
    },
    "conclusionLine": {
      "label": "结论行",
      "unit": "一行结论",
      "source": {
        "kind": "description",
        "text": "交付物正文"
      },
      "shape": [
        {
          "id": "text",
          "label": "结论",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "anchor",
          "label": "依据锚",
          "type": "ref",
          "ref": "anchor",
          "required": true
        },
        {
          "id": "evidence",
          "label": "证据",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "finding": {
      "label": "问题项",
      "unit": "一条问题",
      "source": {
        "kind": "description",
        "text": "交付物 findings 列表"
      },
      "shape": [
        {
          "id": "id",
          "label": "编号",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "text",
          "label": "问题",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "allPass": {
      "label": "全过行",
      "unit": "一行声明",
      "source": {
        "kind": "description",
        "text": "交付物正文或附录"
      },
      "shape": [
        {
          "id": "text",
          "label": "声明",
          "type": "nonEmpty",
          "required": true,
          "values": [
            "全过、无问题"
          ]
        }
      ]
    },
    "term": {
      "label": "英文术语",
      "unit": "一个术语",
      "source": {
        "kind": "description",
        "text": "交付物正文"
      },
      "shape": [
        {
          "id": "name",
          "label": "术语",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "explanation",
          "label": "中文解释",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "issueCard": {
      "label": "问题卡",
      "unit": "一张问题卡",
      "source": {
        "kind": "description",
        "text": "问题卡目录"
      },
      "shape": [
        {
          "id": "suggestion",
          "label": "建议解法",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "quote",
          "label": "原文引句",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "evidence",
          "label": "证据",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "exceedAction": {
      "label": "越界处置动作",
      "unit": "一次越界处置",
      "source": {
        "kind": "description",
        "text": "process.md 段二"
      },
      "shape": [
        {
          "id": "file",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "command",
          "label": "命令原文",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "signature": {
      "label": "签名字段",
      "unit": "一处签名",
      "source": {
        "kind": "description",
        "text": "签字表"
      },
      "shape": [
        {
          "id": "name",
          "label": "所记名称",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "instance",
          "label": "该实例名",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "roundCheck": {
      "label": "轮间核对单",
      "unit": "一行判定",
      "source": {
        "kind": "path",
        "template": ".session/reviews/{session}/round-check.md"
      },
      "shape": [
        {
          "id": "no",
          "label": "#",
          "type": "int",
          "required": true
        },
        {
          "id": "item",
          "label": "条目",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "criterion",
          "label": "判据",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "kind",
          "label": "类型",
          "type": "enum",
          "values": [
            "full",
            "partial",
            "manual"
          ],
          "required": true
        },
        {
          "id": "verdict",
          "label": "判定",
          "type": "enum",
          "values": [
            "hit",
            "miss",
            "na"
          ],
          "required": true
        },
        {
          "id": "reason",
          "label": "reason",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "miss"
          }
        },
        {
          "id": "applicability",
          "label": "为何不适用",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "na"
          }
        },
        {
          "id": "evidence",
          "label": "evidence",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "transcript": {
      "label": "发言记录",
      "unit": "一条发言",
      "source": {
        "kind": "description",
        "text": "progress.md 段二"
      },
      "shape": [
        {
          "id": "speaker",
          "label": "发言者",
          "type": "enum",
          "values": [
            "reviewer-audit",
            "detective-observer",
            "speaker",
            "user"
          ],
          "required": true
        },
        {
          "id": "at",
          "label": "时刻",
          "type": "time",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
          "required": true
        },
        {
          "id": "quote",
          "label": "原文",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "kind",
          "label": "类型",
          "type": "enum",
          "values": [
            "statement",
            "verdict",
            "interrupt"
          ],
          "required": true
        },
        {
          "id": "target",
          "label": "对象",
          "type": "seatId",
          "required": false,
          "when": {
