      "artifact": "artifact.escalationReport",
      "record": "escalationReport",
      "fields": [
        "file",
        "sha256Pair",
        "recoverable",
        "command"
      ]
    },
    "steps": [
      {
        "kind": "halt",
        "text": "停手。"
      },
      {
        "kind": "report",
        "to": "speaker"
      },
      {
        "kind": "voidRound",
        "to": "user",
        "statusField": "round.status",
        "voidedValue": "voided"
      }
    ],
    "residual": {
      "who": "reviewer-audit",
      "sample": 3,
      "fields": [
        "escalationReport.file"
      ],
      "objective": {
        "target": "machine",
        "reason": "NO_MACHINE_OUTPUT"
      }
    }
  },
  "permissions": {
    "policy": "denyByDefault",
    "action": {
      "allow": [
        "record"
      ],
      "forbid": [
        "self-disposal",
        "adjudicate",
        "interrupt"
      ]
    },
    "write": {
      "allow": [
        "artifact.roundCheck",
        "artifact.deliveryAudit"
      ],
      "forbidForms": [
        "path.parentEscape"
      ]
    },
    "command": {
      "allow": [
        "cmd.scs.time",
        "cmd.scs.ledger.gate",
        "cmd.scs.ledger.numbers",
        "cmd.scs.ledger.landings",
        "cmd.git.status",
        "cmd.git.diff",
        "cmd.git.show",
        "cmd.git.log",
        "cmd.git.reflog"
      ],
      "forbidForms": [
        "form.fs.output",
        "form.fs.apply",
        "form.fs.write",
        "form.fs.redirect",
        "form.fs.append",
        "form.env.export",
        "form.env.set",
        "form.env.setx",
        "form.env.envcmd",
        "form.env.psenv",
        "form.env.prefix",
        "form.env.line"
      ]
    }
  },
  "must": [
    {
      "id": "shared.impartial-long-term",
      "criterion": "impartial-long-term",
      "targets": [
        {
          "object": "deliverable.body"
        }
      ]
    },
    {
      "id": "shared.evidence",
      "criterion": "evidence-recomputable",
      "targets": [
        {
          "object": "deliverable.evidence"
        }
      ]
    },
    {
      "id": "shared.plain-expression",
      "criterion": "plain-expression",
      "targets": [
        {
          "object": "deliverable.body"
        }
      ]
    },
    {
      "id": "shared.no-fake-problem",
      "criterion": "no-fake-problem",
      "targets": [
        {
          "object": "deliverable.body"
        },
        {
          "object": "deliverable.appendix"
        }
      ]
    }
  ],
  "never": [
    {
      "id": "shared.no-self-disposal",
      "criterion": "out-of-scope-self-disposal",
      "targets": [
        {
          "object": "deliverable.body"
        }
      ]
    },
    {
      "id": "shared.no-blank-evidence",
      "criterion": "blank-evidence",
      "targets": [
        {
          "object": "deliverable.evidence"
        }
      ]
    },
    {
      "id": "shared.no-proxy-fill",
      "criterion": "proxy-fill",
      "targets": [
        {
          "object": "deliverable.body"
        }
      ]
    }
  ],
  "predicates": {
    "impartial-long-term": {
      "ok": "依据充分、来源多源",
      "bad": "依据不足或来源单一",
      "slots": [
        {
          "op": "countGte",
          "ofRef": "anchor",
          "value": 2
        },
        {
          "op": "distinctGte",
          "ofRef": "anchor",
          "by": "path",
          "byLabel": "文件",
          "value": 2
        }
      ]
    },
    "evidence-recomputable": {
      "ok": "结论行各带依据锚",
      "bad": "结论行缺依据锚",
      "slots": [
        {
          "op": "eachCarries",
          "ofRef": "conclusionLine",
          "carries": "anchor",
          "count": 1
        }
      ]
    },
    "plain-expression": {
      "ok": "术语有中文解释",
      "bad": "术语缺中文解释",
      "slots": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "term",
          "field": "explanation"
        }
      ]
    },
    "no-fake-problem": {
      "ok": "无问题时显式写「全过、无问题」",
      "bad": "无问题时不显式写「全过、无问题」",
      "slots": [
        {
          "op": "whenEmpty",
          "ofRef": "finding",
          "then": {
            "op": "lineExists",
            "ofRef": "allPass",
            "field": "text"
          }
        }
      ]
    },
    "issue-without-solution": {
      "ok": "建议解法栏非空",
      "bad": "留空建议解法栏",
      "slots": [
        {
          "op": "fieldEmpty",
          "ofRef": "issueCard",
          "field": "suggestion"
        }
      ]
    },
    "perfunctory-fix": {
      "ok": "建议附调查依据",
      "bad": "给无依据建议",
      "slots": [
        {
          "op": "eachHas",
          "ofRef": "issueCard",
          "field": "suggestion",
          "pattern": "\\S+:\\d+",
          "hint": "path:line"
        }
      ]
    },
    "out-of-scope-self-disposal": {
      "ok": "越界后留声明",
      "bad": "越界后不留声明",
      "slots": [
        {
          "op": "countGte",
          "ofRef": "exceedAction",
          "value": 1
        }
      ],
      "guard": {
        "op": "lineAbsent",
        "ofRef": "deliverableText",
        "field": "text",
        "pattern": "^\\s*声明[:：]"
      }
    },
    "blank-evidence": {
      "ok": "证据栏完整",
      "bad": "证据栏缺项",
      "slots": [
        {
          "op": "fieldMissing",
          "ofRef": "conclusionLine",
          "field": "evidence",
          "values": [
            "pathLine",
            "commandFirstLine"
          ]
        }
      ]
    },
    "proxy-fill": {
      "ok": "签名与实例一致",
      "bad": "代填他人签名",
      "slots": [
        {
          "op": "fieldNeq",
          "ofRef": "signature",
          "left": "name",
          "right": "instance"
        }
      ]
    }
  }
}