{
  "id": "evidence-before-conclusion",
  "impl": "script",
  "type": "持续适用",
  "title": "说出口的结论必须有可核出处",
  "when": { "field": "writesConclusion", "op": "eq", "value": true },
  "assert": [
    { "field": "anchor", "op": "nonEmpty" },
    { "field": "anchor", "op": "containsAny", "values": [":", "exit", "命令"] },
    { "field": "scope", "op": "nonEmpty" },
    { "field": "target", "op": "nonEmpty" },
    { "field": "numbersCommand", "op": "nonEmpty", "unless": { "field": "hasNumbers", "op": "eq", "value": false } },
    { "field": "lookupReport", "op": "nonEmpty", "unless": { "field": "lookupHit", "op": "eq", "value": true } },
    { "field": "source", "op": "nonEmpty", "unless": { "field": "isCompoundDerivation", "op": "eq", "value": false } },
    { "field": "chain", "op": "nonEmpty", "unless": { "field": "isCompoundDerivation", "op": "eq", "value": false } },
    { "field": "boundary", "op": "nonEmpty", "unless": { "field": "isCompoundDerivation", "op": "eq", "value": false } }
  ],
  "residual": {
    "who": "reviewer-audit",
    "sample": 3,
    "fields": ["anchor", "scope", "target"],
    "objectivePath": "锚四件套（hash + path + line + 行摘录）可形式化后压回机判；范围/目标同题性可由判例库样本收敛"
  },
  "landing": "答案 / 交付账"
}
