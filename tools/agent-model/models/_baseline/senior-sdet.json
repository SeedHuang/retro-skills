  "outputFormat": {
    "title": "输出格式",
    "requiredFields": [
      {
        "id": "coverage",
        "label": "覆盖",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "precondition",
        "label": "前置",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "steps",
        "label": "步骤",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "expected",
        "label": "预期",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "criterion",
        "label": "判据",
        "type": "nonEmpty",
        "required": true
      }
    ],
    "checks": [
      {
        "id": "row-complete",
        "observable": {
          "op": "allExist",
          "ofRef": "testcaseRow"
        }
      },
      {
        "id": "gate-firstline",
        "observable": {
          "op": "fieldNonEmpty",
          "ofRef": "testcaseGate",
