  "templates": {},
  "outputs": {
    "items": []
  },
  "forms": {
    "artifact.round-check": {
      "text": "`round-check.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/round-check.md",
      "requires": "write"
    },
    "cmd.scs.time": {
      "text": "`scs time`",
      "kind": "command",
      "prefix": "scs time",
      "requires": "exec"
    },
    "cmd.git.status": {
      "text": "`git --no-optional-locks status --porcelain`",
      "kind": "command",
      "prefix": "git --no-optional-locks status --porcelain",
      "requires": "exec"
    },
    "cmd.git.diff": {
      "text": "`git --no-optional-locks diff`",
      "kind": "command",
      "prefix": "git --no-optional-locks diff",
      "requires": "exec"
    },
    "cmd.git.log": {
      "text": "`git --no-optional-locks log`",
      "kind": "command",
      "prefix": "git --no-optional-locks log",
      "requires": "exec"
    },
    "path.parentEscape": {
      "text": "`..`",
      "kind": "pattern",
      "match": "\\.\\."
    },
    "form.fs.output": {
      "text": "`--output`",
      "kind": "forbiddenForm",
      "match": "--output",
      "requires": "exec"
    },
    "form.fs.apply": {
      "text": "`--apply`",
      "kind": "forbiddenForm",
      "match": "--apply",
      "requires": "exec"
    },
    "form.fs.write": {
      "text": "`--write`",
      "kind": "forbiddenForm",
      "match": "--write",
      "requires": "exec"
    },
    "form.fs.redirect": {
      "text": "`>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)\\d*>>?\\s*\\S",
      "requires": "exec"
    },
    "form.fs.append": {
      "text": "`>>`",
      "kind": "forbiddenForm",
      "match": ">>",
      "requires": "exec"
    },
    "form.env.export": {
      "text": "`export VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)export\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.set": {
      "text": "`set VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)set\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.setx": {
      "text": "`setx VAR …`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)setx\\s+\\w+",
      "requires": "exec"
    },
    "form.env.envcmd": {
      "text": "`env VAR=… <命令>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)env\\s+\\w+=",
      "requires": "exec"
    },
    "form.env.psenv": {
      "text": "`$env:VAR=…`",
      "kind": "forbiddenForm",
      "match": "\\$env:\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.prefix": {
      "text": "`VAR=… <命令>` 前缀",
      "kind": "forbiddenForm",
      "match": "^\\s*(\\w+=\\S*\\s+)+(\\S)",
      "requires": "exec"
    },
    "form.env.line": {
      "text": "整行 `VAR=…`",
      "kind": "forbiddenForm",
      "match": "^\\s*\\w+=\\S*\\s*$",
      "requires": "exec"
    }
  },
  "predicates": {
    "impartial-long-term": {
      "ok": "依据充分、来源多源",
      "bad": "依据不足或来源单一",
      "slots": [
        {
          "op": "countGte",
          "ofRef": "anchor",
          "value": 2
        },
        {
          "op": "distinctGte",
          "ofRef": "anchor",
          "by": "path",
          "byLabel": "文件",
          "value": 2
        }
      ]
    },
    "evidence-recomputable": {
      "ok": "结论行各带依据锚",
      "bad": "结论行缺依据锚",
      "slots": [
        {
          "op": "eachCarries",
          "ofRef": "conclusionLine",
          "carries": "anchor",
          "count": 1
        }
      ]
    },
    "plain-expression": {
      "ok": "术语有中文解释",
      "bad": "术语缺中文解释",
      "slots": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "term",
          "field": "explanation"
        }
      ]
    },
    "no-fake-problem": {
      "ok": "无问题时显式写「全过、无问题」",
      "bad": "无问题时不显式写「全过、无问题」",
      "slots": [
        {
          "op": "whenEmpty",
          "ofRef": "finding",
          "then": {
            "op": "lineExists",
            "ofRef": "allPass",
            "field": "text"
          }
        }
      ]
    },
    "out-of-scope-self-disposal": {
      "ok": "越界后留声明",
      "bad": "越界后不留声明",
      "slots": [
        {
          "op": "countGte",
          "ofRef": "exceedAction",
          "value": 1
        }
      ],
      "guard": {
        "op": "lineAbsent",
        "ofRef": "deliverableText",
        "field": "text",
        "pattern": "^\\s*声明[:：]"
      }
    },
    "blank-evidence": {
      "ok": "证据栏完整",
      "bad": "证据栏缺项",
      "slots": [
        {
          "op": "fieldMissing",
          "ofRef": "conclusionLine",
          "field": "evidence",
          "values": [
            "pathLine",
            "commandFirstLine"
          ]
        }
      ]
    },
    "proxy-fill": {
      "ok": "签名与实例一致",
      "bad": "代填他人签名",
      "slots": [
        {
          "op": "fieldNeq",
          "ofRef": "signature",
          "left": "name",
          "right": "instance"
        }
      ]
    },
    "issue-without-solution": {
      "ok": "建议解法栏非空",
      "bad": "留空建议解法栏",
      "slots": [
        {
          "op": "fieldEmpty",
          "ofRef": "issueCardFull",
          "field": "suggestion"
        }
      ]
    }
  },
