      },
      "shape": [
        {
          "id": "name",
          "label": "所记名称",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "instance",
          "label": "该实例名",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "roundCheck": {
      "label": "轮间核对单",
      "unit": "一行判定",
      "source": {
        "kind": "path",
        "template": "round-check.md"
      },
      "shape": [
        {
          "id": "no",
          "label": "#",
          "type": "int",
          "required": true
        },
        {
          "id": "item",
          "label": "条目",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "criterion",
          "label": "判据",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "kind",
          "label": "类型",
          "type": "enum",
          "values": [
            "full",
            "partial",
            "manual"
          ],
          "required": true
        },
        {
          "id": "verdict",
          "label": "判定",
          "type": "enum",
          "values": [
            "hit",
            "miss",
            "na"
          ],
          "required": true
        },
        {
          "id": "reason",
          "label": "reason",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "miss"
          }
        },
        {
          "id": "applicability",
          "label": "为何不适用",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "na"
          }
        },
        {
          "id": "evidence",
          "label": "evidence",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "transcript": {
      "label": "发言记录",
      "unit": "一条发言",
      "source": {
        "kind": "description",
        "text": "progress.md 段二"
      },
      "shape": [
        {
          "id": "speaker",
          "label": "发言者",
          "type": "nonEmpty",
