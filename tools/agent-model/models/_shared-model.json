  "permissionGroups": {
    "adjudicate": {
      "label": "裁决他人分歧",
      "signal": {
        "allOf": [
          {
            "op": "eq",
            "ofRef": "transcript",
            "field": "kind",
            "value": "verdict"
          },
          {
            "op": "nonEmpty",
            "ofRef": "transcript",
            "field": "target"
          }
        ]
      }
    },
    "interrupt": {
      "label": "中断评审",
      "signal": {
        "op": "eq",
        "ofRef": "transcript",
        "field": "kind",
        "value": "interrupt"
      }
    },
    "self-disposal": {
      "label": "自行处置越界后果",
      "signal": {
        "op": "countGte",
        "ofRef": "exceedAction",
        "value": 1
      }
    },
    "tamper-original": {
      "label": "删改原文",
      "signal": {
        "op": "nonEmpty",
        "ofRef": "writeAction",
        "field": "path"
      }
    },
    "code-change": {
      "label": "修改代码",
      "signal": {
        "op": "nonEmpty",
        "ofRef": "writeAction",
        "field": "path"
      }
    },
    "review-verdict": {
      "label": "写评审结论",
      "signal": {
        "anyOf": [
          {
            "op": "fieldNotIn",
            "ofRef": "defenseRow",
            "field": "verdict",
            "values": [
              "确认存在",
              "确认不存在"
            ]
          },
          {
            "op": "textMatches",
            "ofRef": "defenseText",
            "field": "text",
            "pattern": "(^|\\|)\\s*(通过|不通过|采纳|驳回|合格|不合格)\\s*(\\||$)"
          }
        ]
      }
    },
    "opinion": {
      "label": "出观点",
      "signal": null,
      "residual": {
        "sample": 3,
        "fields": [
          "deliverableText.text"
        ],
        "objective": {
          "target": "manual",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    "participate-review": {
      "label": "参与评审",
      "signal": null,
      "residual": {
        "sample": 3,
        "fields": [
          "transcript.speaker",
          "transcript.kind"
        ],
        "objective": {
          "target": "manual",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    "tech-verdict": {
      "label": "判技术对错",
      "signal": null,
      "residual": {
        "sample": 3,
        "fields": [
          "deliverableText.text"
        ],
        "objective": {
          "target": "manual",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    }
  },
