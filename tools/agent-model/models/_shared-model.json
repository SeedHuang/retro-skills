{
  "timing": {
    "default": {
      "scene": "deliverable",
      "moment": "end",
      "repeat": "per-round"
    },
    "scenes": {
      "deliverable": "交付物",
      "defense": "答辩",
      "parliament": "议会轮"
    }
  },
  "verdicts": {
    "enum": [
      {
        "id": "hit",
        "label": "命中"
      },
      {
        "id": "miss",
        "label": "未命中",
        "requireReason": true
      },
      {
        "id": "na",
        "label": "不适用",
        "requireApplicability": true
      }
    ],
    "reasonField": "reason",
    "applicabilityField": "applicability",
    "applicabilityPrompt": "为何不适用",
    "noteTemplate": "判定取值：{enum}；{requireReason} 须写 {reasonField}，缺 {reasonField} = {onMissingReasonLabel}；{requireApplicability} 还须写明{applicabilityPrompt}",
    "onMissingReason": {
      "label": "废卡",
      "action": "requireFill",
      "scope": "row",
      "fallback": {
        "becomes": "miss",
        "writeBack": "reason"
      }
    },
    "onMiss": {
      "blocksRound": false,
      "recheck": "next-round",
      "writeBack": "round-check.md"
    }
  },
  "conflict": {
    "title": "冲突裁决",
    "rankLabels": {
      "user": "用户",
      "rule": "规则",
      "seat": "本席"
    },
    "order": [
      "user",
      "rule",
      "seat"
    ],
    "domains": {
      "selfRank": "rankLabels",
      "otherRank": "rankLabels"
    },
    "phrases": {
      "adopt": {
        "label": "采纳",
        "direction": "高优先级",
        "verb": "采纳",
        "mustCarry": {
          "record": "adoptedRef",
          "field": "ref"
        }
      },
      "reject": {
        "label": "不采纳",
        "direction": "低优先级",
        "verb": "不采纳",
        "mustCarry": {
          "record": "concedeCriterion",
          "field": "criterion"
        }
      }
    },
    "decision": {
      "inputs": [
        "selfRank",
        "otherRank"
      ],
      "cases": [
        {
          "when": {
            "lhs": "otherRank",
            "op": "lt",
            "rhs": "selfRank"
          },
          "result": "adopt",
          "mustCarry": "adoptedRef"
        },
        {
          "when": {
            "lhs": "otherRank",
            "op": "gt",
            "rhs": "selfRank"
          },
          "result": "reject",
          "mustCarry": "concedeCriterion"
        },
        {
          "when": {
            "lhs": "otherRank",
            "op": "eq",
            "rhs": "selfRank"
          },
          "result": null,
          "status": "undefined"
        }
      ]
    }
  },
  "globalRules": [
    {
      "id": "must.all-rows",
      "text": "每行必答，缺答 = 不合格；答过也要写明结论。",
      "checks": [
        {
          "op": "eachCarries",
          "ofRef": "roundCheck",
          "carries": "verdict",
          "count": 1
        }
      ],
      "residual": {
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "manual",
          "reason": "REQUIRES_HUMAN_JUDGMENT"
        }
      }
    },
    {
      "id": "must.recomputable-evidence",
      "text": "每行证据栏须含文件:行号。",
      "checks": [
        {
          "op": "eachCarries",
          "ofRef": "roundCheck",
          "carries": "evidence",
          "count": 1
        },
        {
          "op": "eachHas",
          "ofRef": "roundCheck",
          "field": "evidence",
          "pattern": "\\S+:\\d+",
          "hint": "path:line"
        }
      ],
      "residual": {
        "sample": 3,
        "fields": [
          "roundCheck.evidence"
        ],
        "objective": {
          "target": "manual",
          "reason": "CMD_NOT_WHITELISTED"
        }
      }
    }
  ],
  "reasonCodes": {
    "SCHEMA_UNFROZEN": "结构未冻结",
    "RULE_NOT_ENUMERATED": "规则未枚举",
    "NO_MACHINE_OUTPUT": "无机器可读产物",
    "CMD_NOT_WHITELISTED": "校验命令不在白名单",
    "RECORD_NOT_STRUCTURED": "记录未结构化",
    "SIGNAL_NOT_RECORDED": "事件无落账信号",
    "REQUIRES_HUMAN_JUDGMENT": "语义需人判"
  },
  "enums": {
    "action": {
      "values": [
        "fill"
      ],
      "labels": {
        "fill": "填写"
      }
    },
    "mode": {
      "values": [
        "each",
        "whole"
      ],
      "labels": {
        "each": "逐项",
        "whole": ""
      }
    },
    "coverage": {
      "values": [
        "full",
        "partial",
        "manual"
      ],
      "labels": {
        "full": "可机判",
        "partial": "半机判",
        "manual": "人工判定"
      }
    },
    "severity": {
      "values": [
        "P0",
        "P1"
      ],
      "labels": {
        "P0": "P0",
        "P1": "P1"
      }
    },
    "stance": {
      "values": [
        "承认",
        "带依据反驳",
        "部分承认"
      ],
      "labels": {
        "承认": "承认",
        "带依据反驳": "带依据反驳",
        "部分承认": "部分承认"
      }
    },
    "respondentSeats": {
      "values": [
        "respondent-architect",
        "respondent-dev"
      ],
      "labels": {
        "respondent-architect": "架构答辩",
        "respondent-dev": "研发答辩"
      }
    }
  },
  "vocab": {
    "moment": {
      "end": "结束"
    },
    "repeat": {
      "per-round": "每轮"
    },
    "object": {
      "deliverable.body": "交付物正文",
      "deliverable.evidence": "交付物证据",
      "deliverable.appendix": "交付物附录",
      "issue.card.suggestion": "问题卡「建议解法」栏"
    }
  },
  "checklistColumns": [
    "#",
    "条目",
    "判据",
    "类型"
  ],
  "outputKeys": [
    "hit",
    "miss",
    "na",
    "reason",
    "evidence",
    "verdict"
  ],
  "predicates": {
    "impartial-long-term": {
      "ok": "依据充分、来源多源",
      "bad": "依据不足或来源单一",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "countGte",
          "ofRef": "anchor",
          "value": 2
        },
        {
          "op": "distinctGte",
          "ofRef": "anchor",
          "by": "path",
          "byLabel": "文件",
          "value": 2
        }
      ]
    },
    "evidence-recomputable": {
      "ok": "结论行各带依据锚",
      "bad": "结论行缺依据锚",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "eachCarries",
          "ofRef": "conclusionLine",
          "carries": "anchor",
          "count": 1
        }
      ]
    },
    "plain-expression": {
      "ok": "术语有中文解释",
      "bad": "术语缺中文解释",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "term",
          "field": "explanation"
        }
      ]
    },
    "no-fake-problem": {
      "ok": "无问题时显式写「全过、无问题」",
      "bad": "无问题时不显式写「全过、无问题」",
      "appliesWhen": "*",
      "slots": [
        {
          "op": "whenEmpty",
          "ofRef": "finding",
          "then": {
            "op": "lineExists",
            "ofRef": "allPass",
            "field": "text"
          }
        }
      ]
    },
    "issue-without-solution": {
      "ok": "建议解法栏非空",
      "bad": "留空建议解法栏",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer"
      ],
      "slots": [
        {
          "op": "fieldEmpty",
          "ofRef": "issueCard",
          "field": "suggestion"
        }
      ]
    },
    "perfunctory-fix": {
      "ok": "建议附调查依据",
      "bad": "给无依据建议",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer"
      ],
      "slots": [
        {
          "op": "eachHas",
          "ofRef": "issueCard",
          "field": "suggestion",
          "pattern": "\\S+:\\d+",
          "hint": "path:line"
        }
      ]
    },
    "out-of-scope-self-disposal": {
      "ok": "越界后留声明",
      "bad": "越界后不留声明",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "countGte",
          "ofRef": "exceedAction",
          "value": 1
        }
      ],
      "guard": {
        "op": "lineAbsent",
        "ofRef": "deliverableText",
        "field": "text",
        "pattern": "^\\s*声明[:：]"
      }
    },
    "blank-evidence": {
      "ok": "证据栏完整",
      "bad": "证据栏缺项",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "fieldMissing",
          "ofRef": "conclusionLine",
          "field": "evidence",
          "values": [
            "pathLine",
            "commandFirstLine"
          ]
        }
      ]
    },
    "proxy-fill": {
      "ok": "签名与实例一致",
      "bad": "代填他人签名",
      "appliesWhen": [
        "reviewer-audit",
        "reviewer-actuary",
        "reviewer-ai",
        "evidence-reader",
        "detective-observer",
        "reviewer-product",
        "reviewer-interaction",
        "senior-sdet",
        "reviewer-ui",
        "reviewer-frontend"
      ],
      "slots": [
        {
          "op": "fieldNeq",
          "ofRef": "signature",
          "left": "name",
          "right": "instance"
        }
      ]
    }
  },
  "rules": {
    "must": [
      {
        "id": "shared.impartial-long-term",
        "criterion": "impartial-long-term",
        "targets": [
          {
            "object": "deliverable.body"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.evidence",
        "criterion": "evidence-recomputable",
        "targets": [
          {
            "object": "deliverable.evidence"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.plain-expression",
        "criterion": "plain-expression",
        "targets": [
          {
            "object": "deliverable.body"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.no-fake-problem",
        "criterion": "no-fake-problem",
        "targets": [
          {
            "object": "deliverable.body"
          },
          {
            "object": "deliverable.appendix"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      }
    ],
    "never": [
      {
        "id": "shared.no-issue-without-fix",
        "criterion": "issue-without-solution",
        "targets": [
          {
            "object": "issue.card.suggestion"
          }
        ],
        "appliesWhen": [
          "reviewer-actuary",
          "reviewer-ai",
          "reviewer-product",
          "reviewer-interaction",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.no-perfunctory-fix",
        "criterion": "perfunctory-fix",
        "targets": [
          {
            "object": "issue.card.suggestion"
          }
        ],
        "appliesWhen": [
          "reviewer-actuary",
          "reviewer-ai"
        ]
      },
      {
        "id": "shared.no-self-disposal",
        "criterion": "out-of-scope-self-disposal",
        "targets": [
          {
            "object": "deliverable.body"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.no-blank-evidence",
        "criterion": "blank-evidence",
        "targets": [
          {
            "object": "deliverable.evidence"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      },
      {
        "id": "shared.no-proxy-fill",
        "criterion": "proxy-fill",
        "targets": [
          {
            "object": "deliverable.body"
          }
        ],
        "appliesWhen": [
          "reviewer-audit",
          "reviewer-actuary",
          "reviewer-ai",
          "evidence-reader",
          "detective-observer",
          "reviewer-product",
          "reviewer-interaction",
          "senior-sdet",
          "reviewer-ui",
          "reviewer-frontend"
        ]
      }
    ]
  },
  "records": {
    "anchor": {
      "label": "依据锚",
      "unit": "一个锚点",
      "source": {
        "kind": "description",
        "text": "交付物正文的结论段"
      },
      "shape": [
        {
          "id": "path",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "line",
          "label": "行号",
          "type": "int",
          "min": 1,
          "required": true
        },
        {
          "id": "quote",
          "label": "摘句",
          "type": "nonEmpty",
          "required": true
        }
      ],
      "verify": {
        "op": "quoteInLine",
        "path": "path",
        "line": "line",
        "quote": "quote"
      }
    },
    "conclusionLine": {
      "label": "结论行",
      "unit": "一行结论",
      "source": {
        "kind": "description",
