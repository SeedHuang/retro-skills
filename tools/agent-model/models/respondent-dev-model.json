{
  "version": 2,
  "id": "respondent-dev",
  "extends": "_shared-model.json",
  "seat": {
    "id": "respondent-dev",
    "display": "研发答辩",
    "triggers": [
      {
        "id": "reproduce-cards",
        "objects": [
          "issue-card-behavior"
        ],
        "scope": "用命令",
        "action": "reproduce",
        "kind": "need"
      }
    ],
    "description": {
      "template": "当答辩需要{scope}{action}{objects}并给出核实结论",
      "joiner": "、",
      "lastJoiner": "、"
    },
    "artifacts": [
      "artifact.defenseRecord"
    ],
    "tier": "producer"
  },
  "duty": {
    "trigger": {
      "from": "seat.description"
    },
    "action": {
      "verb": "复现",
      "scope": "按项目技术栈",
      "objects": [
        "问题卡所述行为"
      ],
      "emit": [
        "核实结论",
        "答辩记录"
      ],
      "landingSubject": "答辩记录",
      "landing": "outputs.items",
      "landingJoiner": "与 "
    }
  },
  "timing": {
    "scene": "defense",
    "moment": "end",
    "repeat": "per-round"
  },
  "defaultLanding": "artifact.defenseRecord",
  "must": [
    {
      "id": "shared.no-fake-problem",
      "criterion": "no-fake-problem",
      "targets": [
        {
          "object": "deliverable.appendix"
        }
      ]
    }
  ],
  "checklist": {
    "items": [
      {
        "no": 1,
        "seatPrefix": "研发答辩席卡",
        "category": "复现步骤核对",
        "criterion": "respondent.reproduce"
      },
      {
        "no": 2,
        "seatPrefix": "研发答辩席卡",
        "category": "命令输出核对",
        "criterion": "respondent.command"
      },
      {
        "no": 3,
        "seatPrefix": "研发答辩席卡",
        "category": "核实结论核对",
        "criterion": "respondent.verdict"
      },
      {
        "no": 4,
        "seatPrefix": "研发答辩席卡",
        "category": "署名归属核对",
        "criterion": "respondent.signature"
      }
    ]
  },
  "checkCriteria": {
    "respondent.reproduce": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "reproduce",
          "field": "steps"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "evidenceTriple",
          "field": "quote"
        }
      ],
      "negative": {
        "input": {
          "reproduce": {
            "steps": ""
          },
          "evidenceTriple": {
            "quote": "摘句"
          }
        },
        "expect": "fail",
        "failsOn": "reproduce.steps"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "SCHEMA_UNFROZEN"
        }
      }
    },
    "respondent.command": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "commandOutput",
          "field": "firstLine"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "commandOutput",
          "field": "exitCode"
        }
      ],
      "negative": {
        "input": {
          "commandOutput": {
            "firstLine": "编译通过",
            "exitCode": ""
          }
        },
        "expect": "fail",
        "failsOn": "commandOutput.exitCode"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "CMD_NOT_WHITELISTED"
        }
      }
    },
    "respondent.verdict": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldEnumIn",
          "ofRef": "issueCardFull",
          "field": "verdict",
          "values": [
            "确认存在",
            "确认不存在"
          ]
        }
      ],
      "negative": {
        "input": {
          "issueCardFull": {
            "verdict": ""
          }
        },
        "expect": "fail",
        "failsOn": "issueCardFull.verdict"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    },
    "respondent.signature": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "allExist",
          "ofRef": "signature",
          "field": "recordRef"
        },
        {
          "op": "eachCarries",
          "ofRef": "signature",
          "carries": "signer",
          "count": 1
        },
        {
          "op": "fieldEnumIn",
          "ofRef": "signature",
          "field": "signer",
          "valuesRef": "respondentSeats"
        }
      ],
      "negative": {
        "input": {
          "signature": [
            {
              "recordRef": "Q-1-1",
              "signer": "unknown-seat"
            }
          ]
        },
        "expect": "fail",
        "failsOn": "signature.signer"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    }
  },
  "outputFormat": {
    "title": "输出格式",
    "requiredFields": [
      {
        "id": "cardNo",
        "label": "卡号",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "verdict",
        "label": "核实结论",
        "type": "enum",
        "values": [
          "确认存在",
          "确认不存在"
        ],
        "required": true
      },
      {
        "id": "evidence",
        "label": "证据（原文摘句 + 文件 + 行号）",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "stance",
        "label": "立场",
        "type": "enum",
        "values": [
          "承认",
          "带依据反驳",
          "部分承认"
        ],
        "required": true
      },
      {
        "id": "fixLanding",
        "label": "修法落点",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "signer",
        "label": "署名席",
        "type": "nonEmpty",
        "required": true
      }
    ],
    "checks": [
      {
        "id": "verdict-filled",
        "observable": {
          "op": "fieldNonEmpty",
          "ofRef": "issueCardFull",
          "field": "verdict"
        }
      },
      {
        "id": "evidence-triple",
        "observable": {
          "op": "allExist",
          "ofRef": "evidenceTriple"
        }
      },
      {
        "id": "rebuttal-evidence",
        "observable": {
          "op": "whenEq",
          "ofRef": "stance",
          "field": "value",
          "value": "带依据反驳",
          "then": {
            "op": "fieldNonEmpty",
            "ofRef": "stance",
            "field": "evidence"
          }
        }
      },
      {
        "id": "traceable-signer",
        "observable": {
          "op": "fieldEnumIn",
          "ofRef": "signature",
          "field": "signer",
          "valuesRef": "respondentSeats"
        }
      }
    ]
  },
  "templates": {
    "pl.defense-record": {
      "skill": "parliament-ledger",
      "label": "答辩记录",
      "columns": [
        "cardNo",
        "verdict",
        "evidence",
        "stance",
        "fixLanding",
        "signer"
      ]
    }
  },
  "outputs": {
    "items": [
      {
        "phase": "每轮",
        "artifact": "artifact.defenseRecord",
        "template": "pl.defense-record",
        "action": "fill",
        "mode": "each",
        "section": "研发答辩"
      }
    ]
  },
  "forms": {
    "artifact.defenseRecord": {
      "text": "`defense.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/defense.md"
    }
  },
  "records": {
    "allPass": {
      "source": {
        "kind": "description",
        "text": "交付物附录"
      }
    },
    "signature": {
      "label": "署名",
      "unit": "一处署名",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "recordRef",
          "label": "核实记录",
          "type": "ref",
          "ref": "issueCardFull",
          "required": true
        },
        {
          "id": "signer",
          "label": "署名席",
          "type": "seatId",
          "valuesRef": "respondentSeats",
          "required": true
        }
      ]
    },
    "adoptedRef": {
      "label": "采纳依据",
      "unit": "一条依据",
      "source": {
        "kind": "description",
        "text": "round-check.md 冲突裁决段"
      },
      "shape": [
        {
          "id": "ref",
          "label": "依据锚",
          "type": "pathLine",
          "required": true
        }
      ]
    },
    "codeChange": {
      "label": "代码改动",
      "unit": "一次改动",
      "source": {
        "kind": "description",
        "text": "工具调用记录"
      },
      "shape": [
        {
          "id": "path",
          "label": "被改文件",
          "type": "path",
          "required": true
        }
      ]
    },
    "issueCardFull": {
      "label": "问题卡",
      "unit": "一张问题卡",
      "source": {
        "kind": "description",
        "text": "问题卡目录"
      },
      "shape": [
        {
          "id": "cardNo",
          "label": "卡号",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "verdict",
          "label": "核实结论",
          "type": "enum",
          "values": [
            "确认存在",
            "确认不存在"
          ],
          "required": true
        },
        {
          "id": "evidence",
          "label": "证据",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "evidenceTriple": {
      "label": "证据三元组",
      "unit": "一条证据",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "quote",
          "label": "原文摘句",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "path",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "line",
          "label": "行号",
          "type": "int",
          "min": 1,
          "required": true
        },
        {
          "id": "purpose",
          "label": "用途",
          "type": "nonEmpty",
          "required": true
        }
      ],
      "verify": {
        "op": "quoteInLine",
        "path": "path",
        "line": "line",
        "quote": "quote"
      }
    },
    "stance": {
      "label": "立场",
      "unit": "一条立场",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "value",
          "label": "立场",
          "type": "enum",
          "values": [
            "承认",
            "带依据反驳",
            "部分承认"
          ],
          "required": true
        },
        {
          "id": "concede",
          "label": "改判条件",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "evidence",
          "label": "反驳依据",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "value",
            "op": "eq",
            "value": "带依据反驳"
          }
        }
      ]
    },
    "fix": {
      "label": "修法落点",
      "unit": "一条修法",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "landing",
          "label": "修法落点",
          "type": "path",
          "required": true
        },
        {
          "id": "owner",
          "label": "所属席名",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "reproduce": {
      "label": "复现步骤",
      "unit": "一组步骤",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "steps",
          "label": "复现步骤",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "commandOutput": {
      "label": "命令输出",
      "unit": "一次命令",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "command",
          "label": "命令",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "firstLine",
          "label": "输出首行",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "exitCode",
          "label": "退出码",
          "type": "int",
          "required": true
        }
      ]
    }
  },
  "escalation": null,
  "permissions": {
    "policy": "denyByDefault",
    "action": {
      "allow": [
        "verify",
        "reproduce",
        "record"
      ],
      "forbid": [
        "code-change",
        "self-disposal"
      ]
    },
    "write": {
      "allow": [
        "artifact.defenseRecord"
      ],
      "forbidForms": []
    },
    "command": {
      "allow": [
        "cmd.scs.time",
        "cmd.git.status",
        "cmd.git.diff",
        "cmd.git.log"
      ],
      "forbidForms": []
    }
  },
  "boundary": {
    "kind": "policy"
  }
}
