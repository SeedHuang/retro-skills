{
  "version": 2,
  "id": "respondent-dev",
  "extends": "_shared.json",
  "seat": {
    "id": "respondent-dev",
    "display": "研发答辩",
    "triggers": [
      {
        "id": "reproduce-cards",
        "objects": [
          "issue-card-behavior"
        ],
        "scope": "用只读命令与文件证据",
        "action": "recheck",
        "kind": "need"
      }
    ],
    "description": {
      "template": "当答辩需要{scope}{action}{objects}并给出核实结论",
      "joiner": "、",
      "lastJoiner": "、"
    },
    "artifacts": [
      "artifact.defenseRecord"
    ],
    "tier": "producer"
  },
  "duty": {
    "trigger": {
      "from": "seat.description"
    },
    "action": {
      "verb": "复核",
      "scope": "按项目事实",
      "objects": [
        "问题卡所述行为"
      ],
      "emit": [
        "核实结论",
        "答辩记录"
      ],
      "landingSubject": "答辩记录",
      "landing": "outputs.items",
      "landingJoiner": "与 "
    }
  },
  "timing": {
    "scene": "defense",
    "moment": "end",
    "repeat": "per-round"
  },
  "defaultLanding": "artifact.defenseRecord",
  "must": [
    {
      "id": "shared.no-fake-problem",
      "criterion": "no-fake-problem",
      "targets": [
        {
          "object": "deliverable.appendix"
        }
      ]
    }
  ],
  "checklist": {
    "items": [
      {
        "no": 1,
        "seatPrefix": "研发答辩席卡",
        "category": "复现步骤核对",
        "criterion": "respondent.reproduce"
      },
      {
        "no": 2,
        "seatPrefix": "研发答辩席卡",
        "category": "命令输出核对",
        "criterion": "respondent.command"
      },
      {
        "no": 3,
        "seatPrefix": "研发答辩席卡",
        "category": "核实结论核对",
        "criterion": "respondent.verdict"
      },
      {
        "no": 4,
        "seatPrefix": "研发答辩席卡",
        "category": "署名归属核对",
        "criterion": "respondent.signature"
      }
    ]
  },
  "checkCriteria": {
    "respondent.reproduce": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "reproduce",
          "field": "steps"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "evidenceTriple",
          "field": "quote"
        }
      ],
      "negative": {
        "input": {
          "reproduce": {
            "steps": ""
          },
          "evidenceTriple": {
            "quote": "摘句"
          }
        },
        "expect": "fail",
        "failsOn": "reproduce.steps"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "SCHEMA_UNFROZEN"
        }
      }
    },
    "respondent.command": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldNonEmpty",
          "ofRef": "commandOutput",
          "field": "firstLine"
        },
        {
          "op": "fieldNonEmpty",
          "ofRef": "commandOutput",
          "field": "exitCode"
        }
      ],
      "negative": {
        "input": {
          "commandOutput": {
            "firstLine": "编译通过",
            "exitCode": ""
          }
        },
        "expect": "fail",
        "failsOn": "commandOutput.exitCode"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "CMD_NOT_WHITELISTED"
        }
      }
    },
    "respondent.verdict": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "fieldEnumIn",
          "ofRef": "issueCardFull",
          "field": "verdict",
          "values": [
            "确认存在",
            "确认不存在"
          ]
        }
      ],
      "negative": {
        "input": {
          "issueCardFull": {
            "verdict": ""
          }
        },
        "expect": "fail",
        "failsOn": "issueCardFull.verdict"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    },
    "respondent.signature": {
      "action": "verify",
      "mode": "all",
      "observable": [
        {
          "op": "allExist",
          "ofRef": "signature",
          "field": "recordRef"
        },
        {
          "op": "eachCarries",
          "ofRef": "signature",
          "carries": "signer",
          "count": 1
        },
        {
          "op": "fieldEnumIn",
          "ofRef": "signature",
          "field": "signer",
          "valuesRef": "respondentSeats"
        }
      ],
      "negative": {
        "input": {
          "signature": [
            {
              "recordRef": "Q-1-1",
              "signer": "unknown-seat"
            }
          ]
        },
        "expect": "fail",
        "failsOn": "signature.signer"
      },
      "residual": {
        "who": "respondent-dev",
        "sample": 3,
        "fields": [
          "roundCheck.verdict"
        ],
        "objective": {
          "target": "machine",
          "reason": "RECORD_NOT_STRUCTURED"
        }
      }
    }
  },
  "outputFormat": {
    "title": "输出格式",
    "requiredFields": [
      {
        "id": "cardNo",
        "label": "卡号",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "verdict",
        "label": "核实结论",
        "type": "enum",
        "values": [
          "确认存在",
          "确认不存在"
        ],
        "required": true
      },
      {
        "id": "evidence",
        "label": "证据（原文摘句 + 文件 + 行号）",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "stance",
        "label": "立场",
        "type": "enum",
        "values": [
          "承认",
          "带依据反驳",
          "部分承认"
        ],
        "required": true
      },
      {
        "id": "fixLanding",
        "label": "修法落点",
        "type": "nonEmpty",
        "required": true
      },
      {
        "id": "signer",
        "label": "署名席",
        "type": "nonEmpty",
        "required": true
      }
    ],
    "checks": [
      {
        "id": "verdict-filled",
        "observable": {
          "op": "fieldNonEmpty",
          "ofRef": "issueCardFull",
          "field": "verdict"
        }
      },
      {
        "id": "evidence-triple",
        "observable": {
          "op": "allExist",
          "ofRef": "evidenceTriple"
        }
      },
      {
        "id": "rebuttal-evidence",
        "observable": {
          "op": "whenEq",
          "ofRef": "stance",
          "field": "value",
          "value": "带依据反驳",
          "then": {
            "op": "fieldNonEmpty",
            "ofRef": "stance",
            "field": "evidence"
          }
        }
      },
      {
        "id": "traceable-signer",
        "observable": {
          "op": "fieldEnumIn",
          "ofRef": "signature",
          "field": "signer",
          "valuesRef": "respondentSeats"
        }
      }
    ]
  },
  "templates": {
    "pl.defense-record": {
      "skill": "parliament-ledger",
      "label": "答辩记录",
      "columns": [
        "cardNo",
        "verdict",
        "evidence",
        "stance",
        "fixLanding",
        "signer"
      ]
    }
  },
  "outputs": {
    "items": [
      {
        "phase": "每轮",
        "artifact": "artifact.defenseRecord",
        "template": "pl.defense-record",
        "action": "fill",
        "mode": "each",
        "section": "研发答辩"
      }
    ]
  },
  "forms": {
    "artifact.round-check": {
      "text": "`round-check.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/round-check.md",
      "requires": "write"
    },
    "cmd.scs.time": {
      "text": "`scs time`",
      "kind": "command",
      "prefix": "scs time",
      "requires": "exec"
    },
    "cmd.git.status": {
      "text": "`git --no-optional-locks status --porcelain`",
      "kind": "command",
      "prefix": "git --no-optional-locks status --porcelain",
      "requires": "exec"
    },
    "cmd.git.diff": {
      "text": "`git --no-optional-locks diff`",
      "kind": "command",
      "prefix": "git --no-optional-locks diff",
      "requires": "exec"
    },
    "cmd.git.log": {
      "text": "`git --no-optional-locks log`",
      "kind": "command",
      "prefix": "git --no-optional-locks log",
      "requires": "exec"
    },
    "path.parentEscape": {
      "text": "`..`",
      "kind": "pattern",
      "match": "\\.\\."
    },
    "form.fs.output": {
      "text": "`--output`",
      "kind": "forbiddenForm",
      "match": "--output",
      "requires": "exec"
    },
    "form.fs.apply": {
      "text": "`--apply`",
      "kind": "forbiddenForm",
      "match": "--apply",
      "requires": "exec"
    },
    "form.fs.write": {
      "text": "`--write`",
      "kind": "forbiddenForm",
      "match": "--write",
      "requires": "exec"
    },
    "form.fs.redirect": {
      "text": "`>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)\\d*>>?\\s*\\S",
      "requires": "exec"
    },
    "form.fs.append": {
      "text": "`>>`",
      "kind": "forbiddenForm",
      "match": ">>",
      "requires": "exec"
    },
    "form.env.export": {
      "text": "`export VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)export\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.set": {
      "text": "`set VAR=…`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)set\\s+\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.setx": {
      "text": "`setx VAR …`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)setx\\s+\\w+",
      "requires": "exec"
    },
    "form.env.envcmd": {
      "text": "`env VAR=… <命令>`",
      "kind": "forbiddenForm",
      "match": "(^|\\s)env\\s+\\w+=",
      "requires": "exec"
    },
    "form.env.psenv": {
      "text": "`$env:VAR=…`",
      "kind": "forbiddenForm",
      "match": "\\$env:\\w+\\s*=",
      "requires": "exec"
    },
    "form.env.prefix": {
      "text": "`VAR=… <命令>` 前缀",
      "kind": "forbiddenForm",
      "match": "^\\s*(\\w+=\\S*\\s+)+(\\S)",
      "requires": "exec"
    },
    "form.env.line": {
      "text": "整行 `VAR=…`",
      "kind": "forbiddenForm",
      "match": "^\\s*\\w+=\\S*\\s*$",
      "requires": "exec"
    },
    "artifact.defenseRecord": {
      "text": "`defense.md`",
      "kind": "artifact",
      "path": ".session/reviews/{session}/defense.md"
    }
  },
  "records": {
    "anchor": {
      "label": "依据锚",
      "unit": "一个锚点",
      "source": {
        "kind": "description",
        "text": "交付物正文的结论段"
      },
      "shape": [
        {
          "id": "path",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "line",
          "label": "行号",
          "type": "int",
          "min": 1,
          "required": true
        },
        {
          "id": "quote",
          "label": "摘句",
          "type": "nonEmpty",
          "required": true
        }
      ],
      "verify": {
        "op": "quoteInLine",
        "path": "path",
        "line": "line",
        "quote": "quote"
      }
    },
    "conclusionLine": {
      "label": "结论行",
      "unit": "一行结论",
      "source": {
        "kind": "description",
        "text": "交付物正文"
      },
      "shape": [
        {
          "id": "text",
          "label": "结论",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "anchor",
          "label": "依据锚",
          "type": "ref",
          "ref": "anchor",
          "required": true
        },
        {
          "id": "evidence",
          "label": "证据",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "finding": {
      "label": "问题项",
      "unit": "一条问题",
      "source": {
        "kind": "description",
        "text": "交付物 findings 列表"
      },
      "shape": [
        {
          "id": "id",
          "label": "编号",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "text",
          "label": "问题",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "allPass": {
      "label": "全过行",
      "unit": "一行声明",
      "source": {
        "kind": "description",
        "text": "交付物附录"
      },
      "shape": [
        {
          "id": "text",
          "label": "声明",
          "type": "nonEmpty",
          "required": true,
          "values": [
            "全过、无问题"
          ]
        }
      ]
    },
    "term": {
      "label": "英文术语",
      "unit": "一个术语",
      "source": {
        "kind": "description",
        "text": "交付物正文"
      },
      "shape": [
        {
          "id": "name",
          "label": "术语",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "explanation",
          "label": "中文解释",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "issueCard": {
      "label": "问题卡",
      "unit": "一张问题卡",
      "source": {
        "kind": "description",
        "text": "问题卡目录"
      },
      "shape": [
        {
          "id": "suggestion",
          "label": "建议解法",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "quote",
          "label": "原文引句",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "evidence",
          "label": "证据",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "exceedAction": {
      "label": "越界处置动作",
      "unit": "一次越界处置",
      "source": {
        "kind": "description",
        "text": "process.md 段二"
      },
      "shape": [
        {
          "id": "file",
          "label": "文件",
          "type": "path",
          "required": true
        },
        {
          "id": "command",
          "label": "命令原文",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "signature": {
      "label": "署名",
      "unit": "一处署名",
      "source": {
        "kind": "description",
        "text": "答辩记录"
      },
      "shape": [
        {
          "id": "recordRef",
          "label": "核实记录",
          "type": "ref",
          "ref": "issueCardFull",
          "required": true
        },
        {
          "id": "signer",
          "label": "署名席",
          "type": "seatId",
          "valuesRef": "respondentSeats",
          "required": true
        }
      ]
    },
    "roundCheck": {
      "label": "轮间核对单",
      "unit": "一行判定",
      "source": {
        "kind": "path",
        "template": "round-check.md"
      },
      "shape": [
        {
          "id": "no",
          "label": "#",
          "type": "int",
          "required": true
        },
        {
          "id": "item",
          "label": "条目",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "criterion",
          "label": "判据",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "kind",
          "label": "类型",
          "type": "enum",
          "values": [
            "full",
            "partial",
            "manual"
          ],
          "required": true
        },
        {
          "id": "verdict",
          "label": "判定",
          "type": "enum",
          "values": [
            "hit",
            "miss",
            "na"
          ],
          "required": true
        },
        {
          "id": "reason",
          "label": "reason",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "miss"
          }
        },
        {
          "id": "applicability",
          "label": "为何不适用",
          "type": "nonEmpty",
          "required": false,
          "when": {
            "field": "verdict",
            "op": "eq",
            "value": "na"
          }
        },
        {
          "id": "evidence",
          "label": "evidence",
          "type": "nonEmpty",
          "required": true
        }
      ]
    },
    "transcript": {
      "label": "发言记录",
      "unit": "一条发言",
      "source": {
        "kind": "description",
        "text": "progress.md 段二"
      },
      "shape": [
        {
          "id": "speaker",
          "label": "发言者",
          "type": "nonEmpty",
          "required": true
        },
        {
          "id": "at",
          "label": "时刻",
          "type": "time",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
          "required": true
        },
        {
          "id": "kind",
          "label": "类型",
          "type": "enum",
          "values": [
